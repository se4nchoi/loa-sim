# Server-side fetching of a character's lostark.bible data (one character per player action, cached briefly).
# The site's developer allows it for loa-sim. It is on unless set to 0; with 0, players paste their data instead.
BIBLE_SERVER_FETCH=1

# Report dialog: players' bug reports and feature requests become GitHub issues, filed with this token
# (fine-grained, this repo only, Issues: read and write). Leave it empty to turn reporting off; the dialog then
# points players to GitHub. GITHUB_ISSUES_REPO defaults to se4nchoi/loa-sim.
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPO=se4nchoi/loa-sim

# Shared simulations: Upstash REST credentials (server only). Links expire after 30 days.
# Vercel integration names STORAGE_REST_API_URL/TOKEN, STORAGE_KV_REST_API_URL/TOKEN,
# and KV_REST_API_URL/TOKEN are also supported. Never use PUBLIC_ for credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
